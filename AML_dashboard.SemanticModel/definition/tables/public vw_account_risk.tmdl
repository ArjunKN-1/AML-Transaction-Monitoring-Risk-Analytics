	column 'Risk Band' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK('public vw_account_risk'[risk_score]), BLANK(),
			    'public vw_account_risk'[risk_score] >= 45, "High",
			    'public vw_account_risk'[risk_score] <= 25, "Low",
			    "Medium"
			)
